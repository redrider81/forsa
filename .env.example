# CVB Coaching — environment variables
# Kopiera till .env.local för lokal utveckling. Committa aldrig riktiga värden.

# --------------------------------------------------------------- Supabase
# Projekt-URL och publishable key — klientbehöriga, får exponeras i bundeln.
# Hämtas i Supabase-projektets inställningar (API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- OpenAI
# Krävs för AI-funktionerna i portalen. Läses endast server-side.
OPENAI_API_KEY=

# Valfritt. Sätt endast för att låsa en annan modell än den primära.
# Primär modell är gpt-5.6 (GPT-5.6 Sol). Reservkedjan gpt-5.1 → gpt-5 → gpt-4.1
# används enbart om den primära modellen saknas i kontot.
# OPENAI_MODEL=gpt-5.6

# ------------------------------------------------------------ Portallogin
# Hemlighet för signering av sessionscookien. Sätt ett långt slumpat värde
# i produktion, t.ex. med:  openssl rand -base64 32
PORTAL_SESSION_SECRET=

# Lösenord för demokontot carolina@cvbcoaching.se.
# Utan värde används demolösenordet "cvb-demo-2026".
# PORTAL_DEMO_PASSWORD=

# Sätt till false för att dölja den förifyllda demoinloggningen i loginvyn.
# PORTAL_SHOW_DEMO_HINT=false

# ---------------------------------------------------------- Portal e-post
# Lokal utveckling: lämna EMAIL_SEND_ENABLED=false (simulerat, inget skickas).
# Vercel Production: sätt alla tre variablerna nedan för skarp leverans.
EMAIL_SEND_ENABLED=false

# Krävs när EMAIL_SEND_ENABLED=true (Production)
RESEND_API_KEY=

# Verifierad avsändare i Resend — måste matcha domän verifierad i Resend-kontot.
# Exempel när cvbcoaching.se är verifierad:
# EMAIL_FROM=CVB Coaching <kontakt@cvbcoaching.se>
EMAIL_FROM=
